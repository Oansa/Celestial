{
  "name": "celestial-frontend",
  "version": "1.0.0",
  "description": "Frontend for Climate Action Evidence Sharing Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
