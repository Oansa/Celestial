  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "@tanstack/react-query": "^4.0.0",
    "leaflet": "^1.9.4",
    "@types/leaflet": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
